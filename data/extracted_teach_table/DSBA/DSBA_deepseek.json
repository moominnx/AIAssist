{
  "program_info": {
    "name_th": "วิทยาศาสตรบัณฑิต สาขาวิชาวิทยาการข้อมูลและการวิเคราะห์เชิงธุรกิจ",
    "name_en": "Bachelor of Science Program in Data Science and Business Analytics",
    "degree_th": "วท.บ. (วิทยาการข้อมูลและการวิเคราะห์เชิงธุรกิจ)",
    "degree_en": "B.Sc. (Data Science and Business Analytics)",
    "major_th": "วิทยาการข้อมูลและการวิเคราะห์เชิงธุรกิจ",
    "major_en": "Data Science and Business Analytics",
    "total_credits": 132,
    "program_type": "ปริญญาตรี",
    "duration_years": 4,
    "curriculum_year": 2564,
    "institution": "สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง",
    "faculty": "คณะเทคโนโลยีสารสนเทศ"
  },
  "curriculum_structure": {
    "general_education": {
      "credits": 30,
      "subcategories": [
        "กลุ่มวิชาพื้นฐาน",
        "กลุ่มวิชาด้านภาษาและการสื่อสาร",
        "กลุ่มวิชาตามเกณฑ์ของคณะ",
        "กลุ่มวิชาเลือกหมวดวิชาการศึกษาทั่วไป"
      ]
    },
    "specific_courses": {
      "credits": 96,
      "subcategories": [
        "กลุ่มวิชาแกน (45 หน่วยกิต)",
        "กลุ่มพื้นฐานวิชาชีพ (33 หน่วยกิต)",
        "กลุ่มวิชาชีพเฉพาะด้าน (12 หน่วยกิต)",
        "กลุ่มวิชาการศึกษาทางเลือก (6 หน่วยกิต)"
      ]
    },
    "elective_courses": {
      "credits": 6,
      "description": "นักศึกษาเลือกลงทะเบียนเรียนวิชาในกลุ่มวิชาเลือก หรือกลุ่มวิชาชีพเฉพาะด้าน กลุ่มใดก็ได้ จำนวนรวม 6 หน่วยกิต"
    },
    "free_electives": {
      "credits": 6,
      "description": "นักศึกษาสามารถเลือกเรียนในรายวิชาที่เปิดสอนในสถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง จำนวนไม่น้อยกว่า 6 หน่วยกิต"
    }
  },
