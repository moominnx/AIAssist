  "curriculum_structure": {
    "general_education": {
      "credits": 30,
      "subcategories": [
        "กลุ่มวิชาพื้นฐาน (6 หน่วยกิต)",
        "กลุ่มวิชาด้านภาษาและการสื่อสาร (3 หน่วยกิต)",
        "กลุ่มวิชาตามเกณฑ์ของคณะ (9 หน่วยกิต)",
        "กลุ่มวิชาเลือกหมวดวิชาการศึกษาทั่วไป (12 หน่วยกิต)"
      ]
    },
    "specific_courses": {
      "credits": 90,
      "subcategories": [
        "กลุ่มวิชาแกน (12 หน่วยกิต)",
        "กลุ่มวิชาชีพเฉพาะด้าน (72 หน่วยกิต)",
        "กลุ่มวิชาเลือกทางเทคโนโลยีสารสนเทศทางธุรกิจ (6 หน่วยกิต)",
        "กลุ่มวิชาการศึกษาทางเลือก (6 หน่วยกิต)"
      ]
    },
    "elective_courses": {
      "credits": 6,
      "description": "เลือกเรียนจำนวน 6 หน่วยกิต จากรายวิชาในกลุ่มวิชาต่างๆ ผู้เรียนสามารถเลือกตามความต้องการความถนัดในวิชาชีพ หรือเลือกรายวิชาเพื่อเป็นความรู้ในการศึกษาต่อระดับที่สูงขึ้น"
    },
    "free_electives": {
      "credits": 6,
      "description": "เลือกเรียนจากรายวิชาที่เปิดสอนในสถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง จำนวนไม่น้อยกว่า 6 หน่วยกิต"
    }
  },
